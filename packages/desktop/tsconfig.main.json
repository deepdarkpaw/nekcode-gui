{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc 输出不能写进 tsup 的打包目录 out/main：构建后再跑类型检查会把未打包的逐文件产物装进安装包。
    "outDir": ".cache/tsc/main",
    "rootDir": "src/main",
    "lib": ["es2025"]
  },
  "include": ["src/main"],
  // main 直接依赖 shared 和 services；把引用补齐后，desktop 子工程也能稳定复用上游声明产物。
  "references": [{ "path": "../shared" }, { "path": "../services" }]
}
