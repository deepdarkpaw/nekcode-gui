{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc 输出不能写进 tsup 的打包目录 out/preload：构建后再跑类型检查会把未打包的逐文件产物装进安装包。
    "outDir": ".cache/tsc/preload",
    "rootDir": "src",
    "lib": ["es2025", "dom"]
  },
  "include": ["src/preload", "src/shared/armsRumBridgeForward.ts"],
  "references": [{ "path": "../shared" }]
}
