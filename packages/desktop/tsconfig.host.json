{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc 输出不能写进 tsup 的打包目录 out/host：构建后再跑类型检查会把未打包的逐文件产物装进安装包。
    "outDir": ".cache/tsc/host",
    "rootDir": "src/host",
    "lib": ["es2025"]
  },
  "include": ["src/host"],
  // host 既直接依赖 services/shared，也直接 import 了 rpc；补 references 是为了避免它再次把 rpc 源码拉进来检查。
  "references": [{ "path": "../shared" }, { "path": "../services" }, { "path": "../rpc" }]
}
